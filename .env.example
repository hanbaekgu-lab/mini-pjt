# .env.example — 이 파일을 .env로 복사한 뒤 실제 값으로 교체한다. (.env는 git에 올리지 않는다)

# AWS Bedrock (LLM·임베딩)
AWS_ACCESS_KEY_ID=mock-access-key-id
AWS_SECRET_ACCESS_KEY=mock-secret-access-key
AWS_DEFAULT_REGION=<사용할 리전>

# Confluence 게시 방식: fake(로컬 폴더, 기본) | real(실제 Confluence)
CONFLUENCE_MODE=fake

# CONFLUENCE_MODE=real 일 때 필요한 값 (아래는 mock 값)
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=MOCKSPACE
CONFLUENCE_PARENT_PAGE_ID=
CONFLUENCE_USER=mock-user@example.com
CONFLUENCE_API_TOKEN=mock-api-token

# (선택) LangSmith 트레이스. 없으면 logs/trace/에 로컬 JSON으로 남는다.
LANGSMITH_API_KEY=

# (선택) 상태 영구 저장. SQLite 파일 경로를 주면 재시작해도 승인 대기 회의 자료·회의 스냅샷·thread 기록이 남는다.
# 비우면 메모리에만 둔다(기본, 테스트·평가). 예: STATE_DB=data/state/agent.sqlite
STATE_DB=
